# BusinessVault — environment template. Copy to .env.local and fill in.
# NEVER commit real secrets. .env* is git-ignored.

# ------------------------------------------------------------------
# Supabase (production path). Leave empty to run in dev-fallback mode.
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER-SIDE SCRIPTS ONLY (scripts/upload-samples.mjs).
# Never expose it to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
# auto        = use Supabase when the two vars above are set, else dev-fallback
# supabase    = force Supabase (fails fast if unconfigured)
# dev-fallback= force local development mode (NOT production-secure)
AUTH_MODE=auto

# Secret for the dev-fallback session cookie (dev only; change it locally).
DEV_SESSION_SECRET=change-me-to-a-long-random-string

# ------------------------------------------------------------------
# AI provider (VELONA) — used for document classification and intent parsing.
# Leave empty to disable AI features (manual classification only).
# ------------------------------------------------------------------
VELONA_API_KEY=
VELONA_BASE_URL=https://velona.in/v1
VELONA_MODEL=deepseek/deepseek-v4.1-flash-1017

# ------------------------------------------------------------------
# Security overrides
# ------------------------------------------------------------------
# Set to 1 to allow dev-fallback auth in a production build (dangerous).
ALLOW_INSECURE_DEV_AUTH=
